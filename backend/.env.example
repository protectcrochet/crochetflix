# Database
DATABASE_PATH=./database/crochetflix.sqlite

# JWT
JWT_SECRET=tu_secreto_jwt_aqui_cambia_en_produccion
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Stripe
# Obten tus llaves en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Obtén el webhook secret al crear el endpoint en: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Precios (en USD)
PAYMENT_AMOUNT_MENSUAL=4.99
PAYMENT_AMOUNT_ANUAL=49.99
